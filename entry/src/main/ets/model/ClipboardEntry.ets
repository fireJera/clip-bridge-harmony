import { CustomCategory } from './CustomCategory';

/**
 * Represents a single clipboard entry stored in the app.
 *
 * Sensitive content is stored encrypted (contentEncrypted) with a SHA-256
 * contentHash for deduplication. Tags are loaded separately via
 * CategoryRepository and attached to the `tags` field at query time.
 */
export class ClipboardEntry {
  /** Primary key (auto-generated by SQLite). */
  id: number = 0;

  /** SHA-256 hex digest of the original plain-text content. Used for dedup. */
  contentHash: string = '';

  /** AES-256-GCM encrypted content blob. */
  contentEncrypted: Uint8Array = new Uint8Array(0);

  /** Detected content type: text | url | email | phone | image | address. */
  contentType: string = 'text';

  /** Short plain-text preview shown in the list (truncated, not encrypted). */
  contentPreview: string = '';

  /** Absolute path to the full-size image file (only for image entries). */
  imagePath: string = '';

  /** Absolute path to the thumbnail image file (only for image entries). */
  thumbnailPath: string = '';

  /** Size of the original content in bytes. */
  contentSize: number = 0;

  /** Bundle name of the app that produced the clipboard content. */
  sourceApp: string = '';

  /** Whether the entry is pinned (protected from auto-prune). */
  isPinned: boolean = false;

  /** Whether the entry is marked as a favorite. */
  isFavorite: boolean = false;

  /** ISO-8601 timestamp when the entry was pinned. */
  pinnedAt: string = '';

  /** ISO-8601 timestamp when the entry was favorited. */
  favoritedAt: string = '';

  /** ISO-8601 timestamp when the entry was first captured. */
  createdAt: string = '';

  /** ISO-8601 timestamp of the last update. */
  updatedAt: string = '';

  /** AES-256-GCM initialization vector (12 bytes). */
  iv: Uint8Array = new Uint8Array(0);

  /** AES-256-GCM authentication tag (16 bytes). */
  authTag: Uint8Array = new Uint8Array(0);

  /** Tags loaded separately via CategoryRepository. */
  tags: CustomCategory[] = [];

  /**
   * Returns true if this entry is protected from automatic pruning.
   * An entry is protected when it is either pinned or favorited.
   */
  isProtected(): boolean {
    return this.isPinned || this.isFavorite;
  }
}
