/**
 * Represents a user-defined tag/category that can be applied to clipboard entries.
 *
 * Categories support custom names, colors, and manual sort ordering.
 * The `entryCount` field is populated at query time via a JOIN/aggregation
 * and is not persisted directly in the categories table.
 */
export class CustomCategory {
  /** Primary key (auto-generated by SQLite). */
  id: number = 0;

  /** Display name of the category (user-editable). */
  name: string = '';

  /** Hex color string, e.g. '#FF5722', used for UI badges. */
  color: string = '';

  /** Manual sort order (lower values appear first). */
  sortOrder: number = 0;

  /** ISO-8601 timestamp when the category was created. */
  createdAt: string = '';

  /** ISO-8601 timestamp of the last update. */
  updatedAt: string = '';

  /**
   * Number of clipboard entries assigned to this category.
   * Populated by a COUNT query at read time; not stored in the table.
   */
  entryCount: number = 0;
}
