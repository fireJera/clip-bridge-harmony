/**
 * Represents an app that the user has excluded from clipboard monitoring.
 *
 * When an app is blacklisted, clipboard content captured while that app
 * is in the foreground will be silently ignored by the monitor service.
 */
export class AppBlacklistEntry {
  /** Primary key (auto-generated by SQLite). */
  id: number = 0;

  /** HarmonyOS bundle name of the blacklisted app (unique identifier). */
  bundleName: string = '';

  /** Human-readable app name for display in the blacklist UI. */
  appName: string = '';

  /** ISO-8601 timestamp when the app was added to the blacklist. */
  createdAt: string = '';
}
